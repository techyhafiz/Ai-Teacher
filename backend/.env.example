# ===== Copy this file to .env and fill in your values =====

# Your Gemini API key (REQUIRED)
GEMINI_API_KEY=your-api-key-here

# Model IDs (defaults; adjust to your console's exact ids if needed)
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Optional "Nano Banana" whiteboard slides (OFF by default). When true AND a
# GEMINI_API_KEY is set, segments with a slide_prompt get a generated image
# layered over the code-drawn board. On any error the code board still renders.
SLIDES_ENABLED=false

# TPM limits matching your quota
TPM_TEXT_MODEL=250000
TPM_LIVE_MODEL=60000

# Server
HOST=127.0.0.1
PORT=8000
